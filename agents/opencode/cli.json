{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "command.palette.show": "ctrl+shift+p",
    "session.sidebar.toggle": "<leader>b",
    "session.child.first": "<leader>down",
    "session.parent": "up"
  },
  "diffs": {
    "fullscreen": true,
    "single": false,
    "tree": true,
    "view": "split",
    "wrap": "none"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true
}
