{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "command.palette.show": "ctrl+shift+p",
    "session.sidebar.toggle": "<leader>b",
    "session.child.first": "<leader>down",
    "session.parent": "up"
  },
  "diffs": {
    "fullscreen": true,
    "single": false,
    "tree": true,
    "view": "split",
    "wrap": "none"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "image_preview": true,
    "new_location": "launch"
  },
  "animations": true,
  "scroll": {
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "attention": {
    "notifications": true,
    "sound": true
  },
  "debug": {
    "devtools": true
  },
  "tabs": {
    "indicators": "status"
  },
  "theme": {
    "mode": "dark"
  },
  "experimental": {
    "new-designs": true,
    "client-mcp": true
  }
}
