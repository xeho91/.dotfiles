{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true
  },
  "formatter": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "--",
          "chrome-devtools-mcp",
          "--executable-path=/Applications/Chromium.app/Contents/MacOS/Chromium",
          "--isolated",
          "--filesystem-root=/tmp"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd"
        ]
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-tree*", "effect": "allow" },
    { "action": "shell", "resource": "git describe*", "effect": "allow" },
    { "action": "shell", "resource": "git blame*", "effect": "allow" },
    { "action": "shell", "resource": "git shortlog*", "effect": "allow" },
    { "action": "shell", "resource": "git name-rev*", "effect": "allow" },
    { "action": "shell", "resource": "git reflog*", "effect": "allow" },
    { "action": "shell", "resource": "git remote --verbose", "effect": "allow" },
    { "action": "shell", "resource": "git remote get-url*", "effect": "allow" },
    { "action": "shell", "resource": "git tag --list*", "effect": "allow" },
    { "action": "shell", "resource": "git branch --show-current", "effect": "allow" },
    { "action": "shell", "resource": "git branch --list*", "effect": "allow" },
    { "action": "shell", "resource": "git worktree list*", "effect": "allow" },
    { "action": "shell", "resource": "git submodule status*", "effect": "allow" },
    { "action": "shell", "resource": "gh auth status*", "effect": "allow" },
    { "action": "shell", "resource": "gh codespace list*", "effect": "allow" },
    { "action": "shell", "resource": "gh codespace view*", "effect": "allow" },
    { "action": "shell", "resource": "gh gist list*", "effect": "allow" },
    { "action": "shell", "resource": "gh gist view*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue list*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue status*", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr checks*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr diff*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr list*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr status*", "effect": "allow" },
    { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
    { "action": "shell", "resource": "gh project item-list*", "effect": "allow" },
    { "action": "shell", "resource": "gh project item-view*", "effect": "allow" },
    { "action": "shell", "resource": "gh project list*", "effect": "allow" },
    { "action": "shell", "resource": "gh project view*", "effect": "allow" },
    { "action": "shell", "resource": "gh release list*", "effect": "allow" },
    { "action": "shell", "resource": "gh release view*", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view*", "effect": "allow" },
    { "action": "shell", "resource": "gh run list*", "effect": "allow" },
    { "action": "shell", "resource": "gh run view*", "effect": "allow" },
    { "action": "shell", "resource": "gh search *", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow list*", "effect": "allow" },
    { "action": "shell", "resource": "gh workflow view*", "effect": "allow" },
    { "action": "shell", "resource": "perl*", "effect": "deny" },
    { "action": "shell", "resource": "python*", "effect": "deny" },
    { "action": "context7_resolve_library_id", "resource": "*", "effect": "allow" },
    { "action": "context7_query_docs", "resource": "*", "effect": "allow" },
    { "action": "serena_*", "resource": "*", "effect": "allow" }
  ]
}
