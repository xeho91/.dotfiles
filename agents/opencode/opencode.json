{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "serena": {
      "type": "remote",
      "url": "http://127.0.0.1:8000/sse"
    }
  },
  "permission": {
	"bash": {
      "*": "ask",
      "perl*": "deny",
      "python*": "deny"
	},
    "context7_resolve-library-id": "allow",
    "context7_query-docs": "allow",
    "serena_*": "allow",
  }
}
