{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "todo": true
  },
  "formatter": true,
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "mise",
          "exec",
          "--",
          "chrome-devtools-mcp",
          "--executable-path=/Applications/Chromium.app/Contents/MacOS/Chromium",
          "--isolated",
          "--filesystem-root=/tmp"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "serena": {
        "type": "local",
        "command": [
          "serena",
          "start-mcp-server",
          "--context",
          "ide",
          "--project-from-cwd"
        ]
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "perl*", "effect": "deny" },
    { "action": "shell", "resource": "python*", "effect": "deny" },
    { "action": "context7_resolve_library_id", "resource": "*", "effect": "allow" },
    { "action": "context7_query_docs", "resource": "*", "effect": "allow" },
    { "action": "serena_*", "resource": "*", "effect": "allow" }
  ]
}
