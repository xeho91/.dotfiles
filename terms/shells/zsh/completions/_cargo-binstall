#compdef cargo-binstall

autoload -U is-at-least

_cargo-binstall() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--version=[Package version to install]:VERSION:_default' \
'*--targets=[Override binary target set]:TRIPLE:_default' \
'*--bin=[Install only the specified binaries]:BINARY:_default' \
'--manifest-path=[Override Cargo.toml package manifest path]:PATH:_files' \
'(--manifest-path)--git=[Override how to fetch Cargo.toml package manifest]:URL:_default' \
'--bin-dir=[Path template for binary files in packages]:BIN_DIR:_default' \
'--pkg-fmt=[Format for package downloads]:PKG_FMT:_default' \
'--pkg-url=[URL template for package downloads]:TEMPLATE:_default' \
'--rate-limit=[Override the rate limit duration]:LIMIT:_default' \
'*--strategies=[Specify the strategies to be used, binstall will run the strategies specified in order]:STRATEGIES:(crate-meta-data quick-install compile)' \
'*--disable-strategies=[Disable the strategies specified. If a strategy is specified in \`--strategies\` and \`--disable-strategies\`, then it will be removed]:STRATEGIES:(crate-meta-data quick-install compile)' \
'--maximum-resolution-timeout=[Maximum time each resolution (one for each possible target and each strategy), in seconds]:TIMEOUT:_default' \
'--install-path=[Install prebuilt binaries in a custom location]:PATH:_files' \
'--root=[Install binaries with a custom cargo root]:ROOT:_files' \
'--index=[The URL of the registry index to use]:INDEX:_default' \
'(--index)--registry=[Name of the registry to use. Registry names are defined in Cargo configuration files <https\://doc.rust-lang.org/cargo/reference/config.html>]:REGISTRY:_default' \
'*--features=[Activate the specified features when installing from source]:FEATURES:_default' \
'--min-tls-version=[Require a minimum TLS version from remote endpoints]:VERSION:(1.2 1.3)' \
'--dns=[Select the DNS resolver used for all network requests]:RESOLVER:(system hickory)' \
'*--root-certificates=[Specify the root certificates to use for https connections, in addition to default system-wide ones]:PATH:_files' \
'--github-token=[Provide the github token for accessing the restful API of api.github.com]:TOKEN:_default' \
'--settings=[Custom settings file]:SETTINGS:_files' \
'--log-level=[Utility log level]:LEVEL:_default' \
'(--list --prune)--completions=[Print shell completions for the given shell to stdout and exit]:SHELL:(bash elvish fish powershell zsh)' \
'--no-discover-github-token[If \`--github-token\` or environment variable \`GITHUB_TOKEN\`/\`GH_TOKEN\` is not specified, then cargo-binstall will try to extract github token from \`\$HOME/.git-credentials\` or \`\$HOME/.config/gh/hosts.yml\` by default]' \
'--no-symlinks[This flag is now enabled by default thus a no-op]' \
'--dry-run[Dry run, fetch and show changes without installing binaries]' \
'-y[Disable interactive mode / confirmation prompts]' \
'--no-confirm[Disable interactive mode / confirmation prompts]' \
'--no-cleanup[Do not cleanup temporary files]' \
'--continue-on-failure[Continue installing other crates even if one of the crate failed to install]' \
'--no-track[By default, binstall keeps track of the installed packages with metadata files stored in the installation root directory]' \
'--disable-telemetry[Disable statistics collection on popular crates]' \
'--locked[This option will be passed through to all \`cargo-install\` invocations]' \
'--secure[Deprecated, here for back-compat only. Secure is now on by default]' \
'--force[Force a crate to be installed even if it is already installed]' \
'--allow-insecure-http[Allow plaintext HTTP requests to remote endpoints]' \
'--json-output[Print logs in json format to be parsable]' \
'--only-signed[Only install packages that are signed]' \
'(--only-signed)--skip-signatures[Don'\''t check any signatures]' \
'-V[Print version information]' \
'-v[Implies \`--log-level debug\` and it can also be used with \`--version\` to print out verbose information,]' \
'--verbose[Implies \`--log-level debug\` and it can also be used with \`--version\` to print out verbose information,]' \
'(-v --verbose)-q[Equivalent to setting \`log_level\` to \`off\`]' \
'(-v --verbose)--quiet[Equivalent to setting \`log_level\` to \`off\`]' \
'--self-install[]' \
'(--prune)--list[List installed crates and their installation methods (binstall, cargo install, local path, drifted)]' \
'(--list)--prune[Prune stale or drifted binstall records for uninstalled or recompiled packages]' \
'-h[Print help (see more with '\''--help'\'')]' \
'--help[Print help (see more with '\''--help'\'')]' \
'*::crate_names -- Packages to install:_default' \
&& ret=0
}

(( $+functions[_cargo-binstall_commands] )) ||
_cargo-binstall_commands() {
    local commands; commands=()
    _describe -t commands 'cargo-binstall commands' commands "$@"
}

if [ "$funcstack[1]" = "_cargo-binstall" ]; then
    _cargo-binstall "$@"
else
    compdef _cargo-binstall cargo-binstall
fi
