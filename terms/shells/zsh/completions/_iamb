#compdef iamb

autoload -U is-at-least

_iamb() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'--completions=[]:COMPLETIONS:(bash elvish fish powershell zsh)' \
'-P+[]:PROFILE:_default' \
'--profile=[]:PROFILE:_default' \
'-C+[]:CONFIG_DIRECTORY:_files' \
'--config-directory=[]:CONFIG_DIRECTORY:_files' \
'-h[Print help]' \
'--help[Print help]' \
'-V[Print version]' \
'--version[Print version]' \
'::uri -- `matrix\:` uri or `https\://matrix.to` link to open:_default' \
&& ret=0
}

(( $+functions[_iamb_commands] )) ||
_iamb_commands() {
    local commands; commands=()
    _describe -t commands 'iamb commands' commands "$@"
}

if [ "$funcstack[1]" = "_iamb" ]; then
    _iamb "$@"
else
    compdef _iamb iamb
fi
