#compdef lightpanda

_lightpanda() {
    local curcontext="$curcontext" state line
    typeset -A opt_args
    _arguments -C '1: :->command' '*:: :->args'
    case $state in
        command)
            local -a commands=(
                'serve:starts a WebSocket CDP server'
                'fetch:fetches the specified URL'
                'mcp:starts an MCP (Model Context Protocol) server (stdio or HTTP)'
                'agent:starts an interactive AI agent that can browse the web'
                'run:runs a saved script (no LLM), then exits'
                'version:displays the version of lightpanda'
                'completion:prints a shell completion script (bash, fish, zsh)'
                'help:displays this message'
            )
            _describe -t commands command commands
            ;;
        args)
            case $words[1] in
                serve)
                    _arguments -s \
                        '*--host[Host of the CDP server]:host: ' \
                        '*--port[Port of the CDP server]:port: ' \
                        '*--unix-socket[Listen on this Unix-domain socket (mode 0600) instead of TCP]:unix-socket:_files' \
                        '*--advertise-host[The host to advertise, e.g. in the /json/version response]:advertise-host: ' \
                        '*--protocol[Automation protocol to serve]:protocol:((cdp\:"Chrome DevTools Protocol (WebSocket on /)" webdriver\:"WebDriver BiDi (WebSocket on /session) plus the classic WebDriver session endpoints"))' \
                        '*--cdp-max-connections[Maximum number of simultaneous CDP connections]:cdp-max-connections: ' \
                        '*--cdp-max-pending-connections[Maximum pending connections in the accept queue]:cdp-max-pending-connections: ' \
                        '*--cdp-max-message-size[Maximum allowed incoming websocket message size]:cdp-max-message-size: ' \
                        '*--cdp-max-http-message-size[Maximum allowed HTTP request size]:cdp-max-http-message-size: ' \
                        '*--http-session-timeout[Seconds before an idle HTTP session times-out]:http-session-timeout: ' \
                        '*--remote-allow-origins[Origin (e.g. http://localhost:3000) allowed in the Origin header of CDP and BiDi WebSocket upgrades, or * to allow any]:remote-allow-origins: ' \
                        '*--disable-metrics[Disables the /metrics endpoint (Prometheus text format)]' \
                        '*--obey-robots[Fetches and obeys robots.txt of the target page]' \
                        '*--robot-store-entry-limit[Maximum number of entries kept in the RobotStore]:robot-store-entry-limit: ' \
                        '*--cors-store-entry-limit[Maximum number of entries kept in the CorsStore]:cors-store-entry-limit: ' \
                        '*--proxy-bearer-token[Token sent for bearer authentication with the proxy: Proxy-Authorization: Bearer <token>]:proxy-bearer-token: ' \
                        '*--http-proxy[HTTP proxy for all HTTP requests]:http-proxy: ' \
                        '*--http-max-concurrent[Maximum number of concurrent HTTP requests]:http-max-concurrent: ' \
                        '*--http-max-host-open[Maximum open connections to a given host:port]:http-max-host-open: ' \
                        '*--http-nav-delay[Minimum time in ms between two top-level navigations to the same host (see --http-nav-burst)]:http-nav-delay: ' \
                        '*--http-nav-burst[Number of top-level navigations to an idle host allowed to start without waiting for --http-nav-delay]:http-nav-burst: ' \
                        '*--http-timeout[Maximum time in ms the transfer is allowed to complete]:http-timeout: ' \
                        '*--http-version[HTTP version to negotiate]:http-version:((auto\:"" 1.1\:""))' \
                        '*--http-connect-timeout[Time in ms to establish an HTTP connection before timing out]:http-connect-timeout: ' \
                        '*--http-header[Extra custom header added to every outgoing HTTP request, including redirections, in "Name: Value" form]:http-header: ' \
