    (purple)
        words=($line[2] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:purple-command-$line[2]:"
        case $line[2] in
            (add)
_arguments "${_arguments_options[@]}" : \
'-a+[Alias for the host (default\: derived from hostname)]:ALIAS:_default' \
'--alias=[Alias for the host (default\: derived from hostname)]:ALIAS:_default' \
