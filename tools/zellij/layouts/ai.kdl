layout {
    pane stacked=true {
        pane name="mcp:serena" command="mise" {
            args "run" "mcp:serena"
        }

        pane name="server:opencode" command="mise" {
            args "run" "server:opencode"
        }

        pane expanded=true name="opencode" command="mise" {
            args "run" "opencode"
        }
    }
}
